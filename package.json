{
  "name": "clipsx",
  "version": "0.1.0",
  "description": "AI-powered clipboard manager built with Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:tauri-auth-csp": "node --env-file-if-exists=.env.local scripts/generate-tauri-auth-csp.mjs",
    "prepare:tauri-auth-csp:production": "node --env-file=.env.production.local scripts/validate-production-env.mjs && node --env-file=.env.production.local scripts/generate-tauri-auth-csp.mjs",
    "tauri:dev": "npm run prepare:tauri-auth-csp && tauri dev --config src-tauri/tauri.auth.csp.conf.json",
    "tauri:dev:production": "npm run prepare:tauri-auth-csp:production && tauri dev --release --config src-tauri/tauri.auth.csp.conf.json --config src-tauri/tauri.production-dev.conf.json",
    "tauri:build": "npm run prepare:tauri-auth-csp && tauri build --config src-tauri/tauri.auth.csp.conf.json",
    "tauri:build:production:smoke": "npm run prepare:tauri-auth-csp:production && tauri build --no-bundle --config src-tauri/tauri.auth.csp.conf.json --config src-tauri/tauri.production-build.conf.json",
    "tauri:build:production": "npm run prepare:tauri-auth-csp:production && tauri build --config src-tauri/tauri.auth.csp.conf.json --config src-tauri/tauri.production-build.conf.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --bin clipsx",
    "extension:pack": "cargo run --manifest-path src-tauri/Cargo.toml --bin clipsx-extension-tool -- pack",
    "extension:validate": "cargo run --manifest-path src-tauri/Cargo.toml --bin clipsx-extension-tool -- validate",
    "test:all": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --all-features --bin clipsx",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:rust:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --fix --allow-dirty -- -D warnings",
    "ci": "vitest run && npm run lint && npm run format:check && npm run type-check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-features --bin clipsx",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format && npm run type-check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "happy-dom": "^20.14.5",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
