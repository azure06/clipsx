{
  "productName": "ClipsX",
  "version": "0.1.0",
  "identifier": "com.infiniti.clipsx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Japanese", "Italian", "Spanish", "SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/azure06/clipsx/releases/latest/download/latest.json"],
      "pubkey": "dW50cnRzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMTJGQThGREQ4N0Q5OTAKUldTUTJZZmRqL29TWDRsQVV6eFptdk5oL1I1MmNTcS8zUi9tcWx2QWVjYXhqRTg4UnpXK2RJSXEK"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clips Next",
        "width": 1100,
        "height": 600,
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "skipTaskbar": false,
        "visible": false,
        "focus": true,
        "windowEffects": {
          "effects": ["acrylic", "underWindowBackground"]
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self' http://localhost:5173; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tauri.localhost asset: http://asset.localhost; media-src 'self' data: blob: https://tauri.localhost asset: http://asset.localhost; connect-src 'self' http://localhost:5173 ipc://localhost https://api.openrouter.ai; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": true
  }
}
