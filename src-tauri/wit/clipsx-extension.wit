package clipsx:extension@1.0.0;

interface types {
  enum guest-error-code { unsupported, invalid-input, invalid-parameters, failed }

  record guest-error {
    code: guest-error-code,
    message: string,
  }

  variant content {
    text(string),
    binary(list<u8>),
    files(list<string>),
  }

  record representation {
    format-key: string,
    mime-type: option<string>,
    storage-kind: string,
    content: content,
  }

  record facet {
    id: string,
    payload-json: string,
  }

  record code-model { language: option<string>, text: string }
  record table-model { columns: list<string>, rows: list<list<string>> }
  record key-value-entry { key: string, value: string }
  record image-model { source: string }

  variant render-model {
    text(string),
    code(code-model),
    markdown(string),
    table(table-model),
    tree(string),
    key-value(list<key-value-entry>),
    image(image-model),
    error(string),
  }

  record output-representation {
    format-key: string,
    mime-type: string,
    content: output-content,
  }

  variant output-content {
    text(string),
    binary(list<u8>),
  }
}

world extension {
  use types.{representation, facet, render-model, output-representation, guest-error};

  export detect: func(contribution-id: string, input: representation) -> result<list<facet>, guest-error>;
  export render: func(contribution-id: string, input: representation, facet: option<facet>) -> result<render-model, guest-error>;
  export transform: func(contribution-id: string, input: representation, parameters-json: string) -> result<list<output-representation>, guest-error>;
}
